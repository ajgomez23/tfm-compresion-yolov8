# Plantilla de variables de entorno.
#
#     cp .env.example .env
#
# .env no se versiona. Este fichero no debe contener valores reales, solo ejemplos.
#
# Ninguna variable es obligatoria: el código detecta la raíz del proyecto y construye las rutas;
# estas variables solo sirven para cambiar ese comportamiento.


# Rutas.

# Raíz del proyecto. Si no se define, se detecta automáticamente subiendo por el
# árbol de directorios hasta encontrar pyproject.toml.
# Útil cuando se ejecuta desde un contenedor o desde un directorio de trabajo
# ajeno al repositorio.
# TFM_EDGE_ROOT=/ruta/absoluta/al/repositorio

# Directorio de datos. Por defecto <raíz>/data. Conviene apuntarlo a un disco
# con espacio suficiente: el dataset SH17 descomprimido no es pequeño.
# TFM_EDGE_DATA_DIR=/mnt/datos/tfm/data

# Directorio de modelos. Por defecto <raíz>/models.
# TFM_EDGE_MODELS_DIR=/mnt/datos/tfm/models

# Directorio de resultados. Por defecto <raíz>/results. Se recomienda no cambiarlo, porque el
# registro de resultados se versiona con el repositorio.
#
# TFM_EDGE_RESULTS_DIR=


# Identificación del dispositivo.

# Identificador del dispositivo en el que se está ejecutando. Se escribe en cada
# fila del registro y sin él ninguna medida es interpretable (sección 2.3).
# Valores contemplados en configs/benchmark/:
#   workstation_gpu | workstation_cpu | edge_cpu_arm | edge_gpu_jetson | cloud_gpu
# TFM_EDGE_DEVICE_ID=workstation_gpu


# Ejecución.

# Nivel de log por defecto: DEBUG | INFO | WARNING | ERROR
# TFM_EDGE_LOG_LEVEL=INFO

# Semilla global por defecto. Puede sobrescribirse por configuración o por CLI.
# TFM_EDGE_SEED=42


# Nube (sin uso).
#
# La validación del pipeline en SageMaker quedó fuera del alcance y no se ejecutó. Las variables se
# dejan documentadas, pero el proyecto no las lee.
#
# No escribas credenciales de AWS aquí ni en ningún fichero del repositorio; usa el gestor de
# credenciales de AWS (`aws configure`, un perfil de ~/.aws/credentials o un rol de IAM).

# Perfil de AWS a usar (definido en ~/.aws/credentials).
# AWS_PROFILE=tfm

# Región donde lanzar los jobs.
# AWS_DEFAULT_REGION=eu-west-1

# Bucket de S3 para datos de entrada, checkpoints y artefactos de salida.
# TFM_EDGE_S3_BUCKET=nombre-de-tu-bucket

# Rol de ejecución de SageMaker (ARN). Obligatorio para lanzar cualquier job.
# TFM_EDGE_SAGEMAKER_ROLE=arn:aws:iam::000000000000:role/NombreDelRol
