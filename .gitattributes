# Normalización de finales de línea.
#
# El proyecto se ejecuta en WSL2 con Ubuntu y se edita desde Windows. Sin este fichero Git
# convertiría los ficheros de texto a CRLF en el árbol de trabajo, y un script .sh con CRLF falla en
# Linux con "bad interpreter: /bin/bash^M". `text=auto eol=lf` guarda y extrae todo con LF.

* text=auto eol=lf

# Ficheros que tienen que tener LF.
*.sh          text eol=lf
*.py          text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.toml        text eol=lf
*.cfg         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.csv         text eol=lf
Makefile      text eol=lf
Dockerfile*   text eol=lf
.gitignore    text eol=lf
.env.example  text eol=lf

# Binarios: Git no debe modificarlos.
*.pt          binary
*.pth         binary
*.onnx        binary
*.engine      binary
*.tflite      binary
*.bin         binary
*.npy         binary
*.npz         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.pdf         binary
*.xlsx        binary
*.zip         binary
*.tar         binary
*.gz          binary

# Notebooks. Se tratan como texto para poder ver los diffs.
*.ipynb       text eol=lf
